#include <stdio.h>

int main() 
{
    int rows, i, j, k;

    printf("Enter the no. of rows of pyramids: ");
    scanf("%d", &rows);

    for(i = 1; i <= rows; i++) 
    {
        // 1. Print spaces for pyramid shape
        for(j = 1; j <= rows - i; j++) 
        {
            printf(" ");
        }

        // 2. Print asterisks in a row
        for(k = 1; k <= (2 * i - 1); k++) 
        {
            printf("*");
        }

        // 3. Move to the next line
        printf("\n");
    }

    return 0;
}
